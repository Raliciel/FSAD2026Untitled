# Copy to .env (never commit .env). Real environment variables override this file.

# --- Local development ---------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/

# sqlite = zero setup; postgres = use the POSTGRES_* values below
DJANGO_DB=sqlite
POSTGRES_DB=conventionpos
POSTGRES_USER=conventionpos
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Password for the fake accounts made by `python manage.py seed_demo` (local only).
# Pick your own; it must pass the password rules (8+ chars, upper + lower, one of !@#$%^&*()_+).
DEMO_PASSWORD=

# --- Production (change these when deploying) --------------------------------------
# DJANGO_DEBUG=false
# DJANGO_DB=postgres
# DJANGO_ALLOWED_HOSTS=example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DJANGO_ADMIN_URL=staff-console-x7k2/
# DJANGO_BEHIND_PROXY=true
